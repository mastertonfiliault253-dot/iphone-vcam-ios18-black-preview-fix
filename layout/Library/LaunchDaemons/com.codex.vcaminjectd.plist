<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.codex.vcaminjectd</string>
    <key>ProgramArguments</key>
    <array>
        <string>/var/jb/usr/libexec/vcaminjectd</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>5</integer>
    <key>ProcessType</key>
    <string>Background</string>
    <key>UserName</key>
    <string>root</string>
    <key>StandardOutPath</key>
    <string>/var/tmp/vcaminjectd.log</string>
    <key>StandardErrorPath</key>
    <string>/var/tmp/vcaminjectd.log</string>
</dict>
</plist>
