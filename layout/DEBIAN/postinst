#!/bin/sh

set -e

install -d -o mobile -g mobile -m 0755 /var/mobile/Media/VCAM
# iOS 18 cameracaptured's sandbox explicitly grants read-write access under
# its home-relative /Library/VirtualCaptureCard/ directory. Keep the shared
# mmap data plane private to uid mobile and outside unrestricted /var/tmp.
install -d -o mobile -g mobile -m 0700 /var/mobile/Library/VirtualCaptureCard/VCAM
vcam_ref_log=/var/mobile/Library/VirtualCaptureCard/VCAM/vcam-ref.log
: > "$vcam_ref_log" 2>/dev/null || true
chown mobile:mobile "$vcam_ref_log" 2>/dev/null || true
chmod 0600 "$vcam_ref_log" 2>/dev/null || true
if [ -e /var/mobile/Library/Preferences/com.codex.vcam.plist ] && [ ! -e /var/mobile/Media/VCAM/com.codex.vcam.plist ]; then
    cp /var/mobile/Library/Preferences/com.codex.vcam.plist /var/mobile/Media/VCAM/com.codex.vcam.plist
fi

if [ -e /var/mobile/Media/VCAM/com.codex.vcam.plist ]; then
    chown mobile:mobile /var/mobile/Media/VCAM/com.codex.vcam.plist
    chmod 0644 /var/mobile/Media/VCAM/com.codex.vcam.plist
fi
if [ -e /var/mobile/Library/Preferences/com.codex.vcam.plist ]; then
    chown mobile:mobile /var/mobile/Library/Preferences/com.codex.vcam.plist
    chmod 0644 /var/mobile/Library/Preferences/com.codex.vcam.plist
fi

daemon_plist=/var/jb/Library/LaunchDaemons/com.codex.vcamd.plist
if [ -e "$daemon_plist" ]; then
    launchctl bootout system/com.codex.vcamd >/dev/null 2>&1 || true
    for attempt in 1 2 3 4 5; do
        launchctl bootstrap system "$daemon_plist" >/dev/null 2>&1 || true
        if launchctl print system/com.codex.vcamd >/dev/null 2>&1; then
            launchctl kickstart -k system/com.codex.vcamd >/dev/null 2>&1 || true
            break
        fi
        sleep 1
    done
fi

# Dopamine normally has systemhook load ElleKit's TweakLoader into SpringBoard
# and application clients. Never PAC-inject those processes: direct opainject
# can race dyld fixups during launch. vcaminjectd only repairs cameracaptured,
# where constructor proof makes the exact-target recovery observable.
vcam_inject_log=/var/tmp/vcam-postinst-inject.log
: > "$vcam_inject_log" 2>/dev/null || true

vcam_log_injection() {
    printf '%s\n' "$*" >> "$vcam_inject_log" 2>/dev/null || true
}

# A loaded dylib cannot be replaced in place. Upgrades used to inject the new
# client into the existing process, leaving the old Objective-C classes alive.
# Respawn both exact hosts first. ElleKit owns SpringBoard loading;
# vcaminjectd is the sole opainject owner for cameracaptured.
: > /var/tmp/vcam-springboard-client.log 2>/dev/null || true
: > /var/tmp/vcam-ref-msd.log 2>/dev/null || true
killall -9 SpringBoard cameracaptured >/dev/null 2>&1 || true
sleep 1
vcam_log_injection "automatic target=SpringBoard reason=ElleKit"
vcam_log_injection "deferred target=cameracaptured reason=vcaminjectd"

inject_daemon_plist=/var/jb/Library/LaunchDaemons/com.codex.vcaminjectd.plist
if [ -e "$inject_daemon_plist" ]; then
    launchctl bootout system/com.codex.vcaminjectd >/dev/null 2>&1 || true
    for attempt in 1 2 3 4 5; do
        launchctl bootstrap system "$inject_daemon_plist" >/dev/null 2>&1 || true
        if launchctl print system/com.codex.vcaminjectd >/dev/null 2>&1; then
            launchctl kickstart -k system/com.codex.vcaminjectd >/dev/null 2>&1 || true
            break
        fi
        sleep 1
    done
fi

exit 0
