#!/bin/sh

set -e

install -d -o mobile -g mobile -m 0755 /var/mobile/Media/VCAM
if [ -e /var/mobile/Library/Preferences/com.codex.vcam.plist ] && [ ! -e /var/mobile/Media/VCAM/com.codex.vcam.plist ]; then
    cp /var/mobile/Library/Preferences/com.codex.vcam.plist /var/mobile/Media/VCAM/com.codex.vcam.plist
fi

if [ -e /var/mobile/Media/VCAM/com.codex.vcam.plist ]; then
    chown mobile:mobile /var/mobile/Media/VCAM/com.codex.vcam.plist
    chmod 0644 /var/mobile/Media/VCAM/com.codex.vcam.plist
fi
if [ -e /var/mobile/Library/Preferences/com.codex.vcam.plist ]; then
    chown mobile:mobile /var/mobile/Library/Preferences/com.codex.vcam.plist
    chmod 0644 /var/mobile/Library/Preferences/com.codex.vcam.plist
fi

daemon_plist=/var/jb/Library/LaunchDaemons/com.codex.vcamd.plist
if [ -e "$daemon_plist" ]; then
    launchctl bootout user/foreground/com.codex.vcamd >/dev/null 2>&1 || \
        launchctl bootout system/com.codex.vcamd >/dev/null 2>&1 || true
    for attempt in 1 2 3 4 5; do
        launchctl bootstrap system "$daemon_plist" >/dev/null 2>&1 || true
        if launchctl print user/foreground/com.codex.vcamd >/dev/null 2>&1; then
            launchctl kickstart -k user/foreground/com.codex.vcamd >/dev/null 2>&1 || true
            break
        fi
        sleep 1
    done
fi

# Dopamine normally has systemhook load ElleKit's TweakLoader. If that loader
# is missing from an already-running target, recover this package's two exact
# clients without widening injection to Camera, WebKit or third-party apps.
vcam_inject_log=/var/tmp/vcam-postinst-inject.log
: > "$vcam_inject_log" 2>/dev/null || true

vcam_log_injection() {
    printf '%s\n' "$*" >> "$vcam_inject_log" 2>/dev/null || true
}

vcam_best_effort_inject() {
    target_name="$1"
    target_dylib="$2"
    injector=/var/jb/usr/bin/opainject

    case "$target_name" in
        SpringBoard) process_pattern='/SpringBoard.app/SpringBoard' ;;
        mediaserverd) process_pattern='/usr/sbin/mediaserverd' ;;
        *)
            vcam_log_injection "refused target=$target_name"
            return 0
            ;;
    esac

    if [ ! -x "$injector" ] || [ ! -f "$target_dylib" ]; then
        vcam_log_injection "unavailable target=$target_name injector=$injector dylib=$target_dylib"
        return 0
    fi

    for inject_attempt in 1 2 3 4 5; do
        target_pid="$(ps ax 2>/dev/null | grep "$process_pattern" | grep -v grep | \
            sed -n '1{s/^[[:space:]]*//;s/[[:space:]].*$//;p;}')" || target_pid=""
        if [ -z "$target_pid" ]; then
            vcam_log_injection "retry target=$target_name old_pid=none new_pid=none reason=process-not-found attempt=$inject_attempt"
            sleep 1
            continue
        fi

        vcam_log_injection "attempt target=$target_name pid=$target_pid dylib=$target_dylib attempt=$inject_attempt"
        inject_status=0
        "$injector" "$target_pid" "$target_dylib" >> "$vcam_inject_log" 2>&1 || inject_status="$?"
        sleep 1

        observed_pid="$(ps ax 2>/dev/null | grep "$process_pattern" | grep -v grep | \
            sed -n '1{s/^[[:space:]]*//;s/[[:space:]].*$//;p;}')" || observed_pid=""
        if [ "$observed_pid" = "$target_pid" ]; then
            if [ "$inject_status" -eq 0 ]; then
                vcam_log_injection "completed target=$target_name pid=$target_pid attempt=$inject_attempt"
                return 0
            fi
            vcam_log_injection "retry target=$target_name old_pid=$target_pid new_pid=$observed_pid reason=injector-status-$inject_status attempt=$inject_attempt"
        else
            vcam_log_injection "retry target=$target_name old_pid=$target_pid new_pid=$observed_pid reason=pid-changed attempt=$inject_attempt"
        fi
        sleep 1
    done

    vcam_log_injection "exhausted target=$target_name attempts=5"
    return 0
}

vcam_best_effort_inject SpringBoard /var/jb/Library/MobileSubstrate/DynamicLibraries/VCAMSpringBoardClient.dylib
vcam_best_effort_inject mediaserverd /var/jb/Library/MobileSubstrate/DynamicLibraries/VCAMMediaServerClient.dylib

inject_daemon_plist=/var/jb/Library/LaunchDaemons/com.codex.vcaminjectd.plist
if [ -e "$inject_daemon_plist" ]; then
    launchctl bootout system/com.codex.vcaminjectd >/dev/null 2>&1 || true
    for attempt in 1 2 3 4 5; do
        launchctl bootstrap system "$inject_daemon_plist" >/dev/null 2>&1 || true
        if launchctl print system/com.codex.vcaminjectd >/dev/null 2>&1; then
            launchctl kickstart -k system/com.codex.vcaminjectd >/dev/null 2>&1 || true
            break
        fi
        sleep 1
    done
fi

exit 0
