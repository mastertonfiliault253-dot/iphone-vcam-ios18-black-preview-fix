{
  "schemaVersion": 2,
  "scheme": "rootless",
  "delivery": "single-package-two-injections-one-worker",
  "currentPackage": {
    "identifier": "com.codex.vcam",
    "implementedTarget": "VCAMSystemBridge"
  },
  "targets": [
    {
      "name": "VCAMMediaServerClient",
      "binary": "VCAMMediaServerClient.dylib",
      "role": "nonblocking-latest-frame-consumer",
      "bundleIds": [],
      "executables": ["mediaserverd"],
      "injected": true,
      "forbiddenDependencies": ["FFmpeg", "UIKit", "AVAssetReader", "network"]
    },
    {
      "name": "VCAMSpringBoardClient",
      "binary": "VCAMSpringBoardClient.dylib",
      "role": "white-dot-picker-configuration-and-preview",
      "bundleIds": ["com.apple.springboard"],
      "executables": ["SpringBoard"],
      "injected": true,
      "forbiddenDependencies": ["FFmpeg", "RTSP decoder", "local video decoder"]
    },
    {
      "name": "vcamd",
      "binary": "vcamd",
      "role": "package-owned-media-worker",
      "bundleIds": [],
      "executables": ["vcamd"],
      "injected": false,
      "sources": ["local-image", "local-video", "obs-websocket", "rtsp-ffmpeg-videotoolbox"]
    }
  ]
}
